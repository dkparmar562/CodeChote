@@ -0,0 +1,77 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { mainWindow } from '../../../../base/browser/window.js';
+import { generateUuid } from '../../../../base/common/uuid.js';
+import { Schemas } from '../../../../base/common/network.js';
+import { URI } from '../../../../base/common/uri.js';
+
+/**
+ * When the workbench runs inside the iOS app, file and folder pickers are shown by the app (a
+ * touch-friendly browser of the remote host) instead of the desktop-style quick-input dialog.
+ */
+
+interface INativeHost {
+	postMessage(message: unknown): void;
+}
+
+export interface INativePickOptions {
+	readonly canSelectFiles: boolean;
+	readonly canSelectFolders: boolean;
+	readonly title?: string;
+	readonly defaultUri?: URI;
+	readonly remoteAuthority?: string;
+}
+
+class NativeResourcePicker {
+
+	private readonly pending = new Map<string, (path: string | undefined) => void>();
+
+	private get host(): INativeHost | undefined {
+		const win = mainWindow as unknown as { webkit?: { messageHandlers?: { cc?: INativeHost } }; __ccNav?: unknown };
+		// `__ccNav` only exists once the phone layout is active inside the app.
+		return win.__ccNav ? win.webkit?.messageHandlers?.cc : undefined;
+	}
+
+	get isAvailable(): boolean {
+		return !!this.host;
+	}
+
+	async pick(options: INativePickOptions): Promise<URI[] | undefined> {
+		const host = this.host;
+		if (!host) {
+			return undefined;
+		}
+
+		const id = generateUuid();
+		const result = new Promise<string | undefined>(resolve => this.pending.set(id, resolve));
+		host.postMessage({
+			nav: 'pick',
+			id,
+			mode: options.canSelectFolders && options.canSelectFiles ? 'any' : options.canSelectFolders ? 'folder' : 'file',
+			title: options.title,
+			path: options.defaultUri?.path,
+		});
+
+		const path = await result;
+		if (!path) {
+			return undefined;
+		}
+		return [options.remoteAuthority
+			? URI.from({ scheme: Schemas.vscodeRemote, authority: options.remoteAuthority, path })
+			: URI.file(path)];
+	}
+
+	/** Called by the app with the chosen path, or nothing if the user cancelled. */
+	resolve(id: string, path: string | null | undefined): void {
+		const resolve = this.pending.get(id);
+		if (resolve) {
+			this.pending.delete(id);
+			resolve(path ?? undefined);
+		}
+	}
+}
+
+export const nativeResourcePicker = new NativeResourcePicker();
