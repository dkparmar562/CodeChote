+/**
+ * On a phone only one part of the workbench is on screen at a time. A destination is the part
+ * that currently fills the screen.
+ */
+export type MobileDestination = 'sidebar' | 'editor' | 'panel' | 'auxiliarybar';
+
+/** Viewports up to this width (CSS px) use the phone layout. */
+export const PHONE_MAX_WIDTH = 700;
+
+export const IMobileLayoutService = createDecorator<IMobileLayoutService>('mobileLayoutService');
+
+export interface IMobileLayoutService {
+
+	readonly _serviceBrand: undefined;
+
+	/** True when the workbench was started in a phone-sized viewport. Decided once at startup. */
+	readonly isPhoneLayout: boolean;
+
+	/** The part currently filling the screen, or `undefined` before the phone layout is applied. */
+	readonly mobileDestination: MobileDestination | undefined;
+
+	readonly onDidChangeMobileDestination: Event<MobileDestination | undefined>;
+
+	/** Show exactly one part, full screen, and hide the others. */
+	setMobileDestination(destination: MobileDestination): void;
+}
