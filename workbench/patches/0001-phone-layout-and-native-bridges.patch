@@ -0,0 +1,279 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { mainWindow } from '../../../../base/browser/window.js';
+import { RunOnceScheduler } from '../../../../base/common/async.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { FileAccess } from '../../../../base/common/network.js';
+import { ThemeIcon } from '../../../../base/common/themables.js';
+import { URI } from '../../../../base/common/uri.js';
+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+import { IWorkbenchContribution } from '../../../common/contributions.js';
+import { IViewDescriptorService, ViewContainer, ViewContainerLocation } from '../../../common/views.js';
+import { IEditorService } from '../../../services/editor/common/editorService.js';
+import { ILifecycleService, LifecyclePhase } from '../../../services/lifecycle/common/lifecycle.js';
+import { IWorkbenchLayoutService, Parts } from '../../../services/layout/browser/layoutService.js';
+import { IMobileLayoutService, MobileDestination } from '../../../services/layout/browser/mobileLayoutService.js';
+import { nativeResourcePicker } from '../../../services/dialogs/browser/nativeResourcePicker.js';
+import { IPaneCompositePartService } from '../../../services/panecomposite/browser/panecomposite.js';
+import { IThemeService } from '../../../../platform/theme/common/themeService.js';
+
+/**
+ * One entry in the phone navigation. The native app draws the bottom bar and the full list; this
+ * side only reports what exists and switches to whatever the app asks for.
+ */
+interface IDestination {
+	readonly id: string;
+	readonly title: string;
+	readonly group: 'core' | 'sidebar' | 'panel' | 'agents' | 'files';
+	/** Codicon id, when the container uses a built-in icon. */
+	readonly symbol?: string;
+	/** PNG data URL, when the container ships its own icon. */
+	icon?: string;
+}
+
+interface INativeHost {
+	postMessage(message: unknown): void;
+}
+
+const EDITOR_ID = 'editor';
+const CONTAINER_PREFIX = 'container:';
+const FILE_PREFIX = 'file:';
+
+const LOCATION_INFO: ReadonlyArray<{ location: ViewContainerLocation; key: string; destination: MobileDestination; group: IDestination['group'] }> = [
+	{ location: ViewContainerLocation.Sidebar, key: 'sidebar', destination: 'sidebar', group: 'sidebar' },
+	{ location: ViewContainerLocation.Panel, key: 'panel', destination: 'panel', group: 'panel' },
+	{ location: ViewContainerLocation.AuxiliaryBar, key: 'auxiliarybar', destination: 'auxiliarybar', group: 'agents' },
+];
+
+export class MobileDestinations extends Disposable implements IWorkbenchContribution {
+
+	private readonly iconCache = new Map<string, Promise<string | undefined>>();
+	private readonly publishScheduler = this._register(new RunOnceScheduler(() => this.publish(), 150));
+	private destinations: IDestination[] = [];
+	private lastActive: string | undefined;
+
+	constructor(
+		@IMobileLayoutService private readonly mobileLayoutService: IMobileLayoutService,
+		@IWorkbenchLayoutService private readonly layoutService: IWorkbenchLayoutService,
+		@IPaneCompositePartService private readonly paneCompositeService: IPaneCompositePartService,
+		@IViewDescriptorService private readonly viewDescriptorService: IViewDescriptorService,
+		@ICommandService private readonly commandService: ICommandService,
+		@IEditorService private readonly editorService: IEditorService,
+		@ILifecycleService private readonly lifecycleService: ILifecycleService,
+		@IThemeService private readonly themeService: IThemeService,
+	) {
+		super();
+
+		// Tooling hook (also outside the phone layout): run any workbench command from the host.
+		(mainWindow as unknown as { __ccDev: unknown }).__ccDev = {
+			runCommand: (id: string, ...args: unknown[]) => this.commandService.executeCommand(id, ...args),
+		};
+
+		if (!this.mobileLayoutService.isPhoneLayout) {
+			return;
+		}
+
+		// The native app calls this to switch screens.
+		(mainWindow as unknown as { __ccNav: unknown }).__ccNav = {
+			activate: (id: string) => this.activate(id),
+			refresh: () => this.publishScheduler.schedule(0),
+			// For tests and tooling: run any workbench command from the host.
+			runCommand: (id: string, ...args: unknown[]) => this.commandService.executeCommand(id, ...args),
+			pickResult: (id: string, path: string | null) => nativeResourcePicker.resolve(id, path),
+		};
+
+		this.lifecycleService.when(LifecyclePhase.Ready).then(() => {
+			// The native bar replaces the activity bar. (The grid only exists from the Ready phase on.)
+			this.layoutService.setPartHidden(true, Parts.ACTIVITYBAR_PART);
+		});
+
+		// Restoring the workbench reopens its default parts, so choose the first screen afterwards.
+		this.lifecycleService.when(LifecyclePhase.Restored).then(() => {
+			this.mobileLayoutService.setMobileDestination('editor');
+			this.publishScheduler.schedule(0);
+
+			// Then follow the user: opening a file from Files or Search should show the file.
+			mainWindow.setTimeout(() => {
+				this._register(this.editorService.onDidActiveEditorChange(() => {
+					if (this.editorService.activeEditor && this.mobileLayoutService.mobileDestination === 'sidebar') {
+						this.mobileLayoutService.setMobileDestination('editor');
+					}
+				}));
+			}, 1500);
+		});
+
+		// Let the native bar and safe areas follow the workbench theme.
+		this._register(this.themeService.onDidColorThemeChange(() => this.publishTheme()));
+		this.lifecycleService.when(LifecyclePhase.Restored).then(() => mainWindow.setTimeout(() => this.publishTheme(), 500));
+
+		// Keep the list and the highlighted item current.
+		this._register(this.mobileLayoutService.onDidChangeMobileDestination(() => this.publishActive()));
+		this._register(this.paneCompositeService.onDidPaneCompositeOpen(() => { this.publishActive(); this.publishScheduler.schedule(); }));
+		this._register(this.paneCompositeService.onDidPaneCompositeClose(() => this.publishActive()));
+		this._register(this.viewDescriptorService.onDidChangeViewContainers(() => this.publishScheduler.schedule()));
+		this._register(this.editorService.onDidActiveEditorChange(() => this.publishScheduler.schedule()));
+		this._register(this.editorService.onDidCloseEditor(() => this.publishScheduler.schedule()));
+		this._register(this.editorService.onDidVisibleEditorsChange(() => this.publishScheduler.schedule()));
+		// Extensions contribute their views late, so containers appear (and fill with views) over time.
+		for (const { location } of LOCATION_INFO) {
+			for (const container of this.viewDescriptorService.getViewContainersByLocation(location)) {
+				this.watchContainer(container);
+			}
+		}
+		this._register(this.viewDescriptorService.onDidChangeViewContainers(e => e.added.forEach(a => this.watchContainer(a.container))));
+	}
+
+	private readonly watched = new Set<string>();
+
+	private watchContainer(container: ViewContainer): void {
+		if (this.watched.has(container.id)) {
+			return;
+		}
+		this.watched.add(container.id);
+		this._register(this.viewDescriptorService.getViewContainerModel(container).onDidChangeActiveViewDescriptors(() => this.publishScheduler.schedule()));
+	}
+
+	// MARK: Switching
+
+	private async activate(id: string): Promise<void> {
+		if (id === EDITOR_ID) {
+			this.mobileLayoutService.setMobileDestination('editor');
+			return;
+		}
+
+		if (id.startsWith(FILE_PREFIX)) {
+			const resource = URI.parse(id.slice(FILE_PREFIX.length));
+			this.mobileLayoutService.setMobileDestination('editor');
+			await this.editorService.openEditor({ resource });
+			return;
+		}
+
+		if (id.startsWith(CONTAINER_PREFIX)) {
+			const [, key, ...rest] = id.split(':');
+			const containerId = rest.join(':');
+			const info = LOCATION_INFO.find(i => i.key === key);
+			if (!info) {
+				return;
+			}
+			this.mobileLayoutService.setMobileDestination(info.destination);
+			await this.paneCompositeService.openPaneComposite(containerId, info.location, true);
+			if (containerId === 'terminal') {
+				await this.commandService.executeCommand('workbench.action.terminal.focus');
+			}
+		}
+	}
+
+	// MARK: Reporting
+
+	private post(message: unknown): void {
+		const host = (mainWindow as unknown as { webkit?: { messageHandlers?: { cc?: INativeHost } } }).webkit?.messageHandlers?.cc;
+		host?.postMessage(message);
+	}
+
+	private computeActive(): string | undefined {
+		switch (this.mobileLayoutService.mobileDestination) {
+			case 'editor':
+				return EDITOR_ID;
+			case 'sidebar':
+				return this.activeContainerId(ViewContainerLocation.Sidebar, 'sidebar');
+			case 'panel':
+				return this.activeContainerId(ViewContainerLocation.Panel, 'panel');
+			case 'auxiliarybar':
+				return this.activeContainerId(ViewContainerLocation.AuxiliaryBar, 'auxiliarybar');
+			default:
+				return undefined;
+		}
+	}
+
+	private activeContainerId(location: ViewContainerLocation, key: string): string | undefined {
+		const id = this.paneCompositeService.getActivePaneComposite(location)?.getId();
+		return id ? `${CONTAINER_PREFIX}${key}:${id}` : undefined;
+	}
+
+	private publishTheme(): void {
+		const style = mainWindow.getComputedStyle(this.layoutService.mainContainer);
+		const read = (name: string) => style.getPropertyValue(name).trim() || undefined;
+		this.post({
+			nav: 'theme',
+			top: read('--vscode-titleBar-activeBackground') ?? read('--vscode-editor-background'),
+			bottom: read('--vscode-sideBar-background') ?? read('--vscode-editor-background'),
+		});
+	}
+
+	private publishActive(): void {
+		const active = this.computeActive();
+		if (active !== this.lastActive) {
+			this.lastActive = active;
+			this.post({ nav: 'active', id: active ?? null });
+		}
+	}
+
+	private async publish(): Promise<void> {
+		const destinations: IDestination[] = [{ id: EDITOR_ID, title: 'Editor', group: 'core', symbol: 'code' }];
+
+		for (const { location, key, group } of LOCATION_INFO) {
+			for (const container of this.viewDescriptorService.getViewContainersByLocation(location)) {
+				if (this.viewDescriptorService.getViewContainerModel(container).activeViewDescriptors.length === 0) {
+					continue;
+				}
+				const entry: IDestination = {
+					id: `${CONTAINER_PREFIX}${key}:${container.id}`,
+					title: typeof container.title === 'string' ? container.title : container.title.value,
+					group,
+					symbol: ThemeIcon.isThemeIcon(container.icon) ? container.icon.id : undefined,
+				};
+				if (container.icon && !ThemeIcon.isThemeIcon(container.icon)) {
+					entry.icon = await this.rasterize(container.icon);
+				}
+				destinations.push(entry);
+			}
+		}
+
+		const seen = new Set<string>();
+		for (const editor of this.editorService.editors) {
+			const resource = editor.resource;
+			if (!resource || seen.has(resource.toString()) || seen.size >= 30) {
+				continue;
+			}
+			seen.add(resource.toString());
+			destinations.push({ id: `${FILE_PREFIX}${resource.toString()}`, title: editor.getName(), group: 'files' });
+		}
+
+		this.destinations = destinations;
+		this.post({ nav: 'destinations', items: destinations });
+		this.lastActive = undefined;
+		this.publishActive();
+	}
+
+	/** Extension icons are images behind a URL; hand the app a small PNG it can tint as a template. */
+	private rasterize(icon: URI | { dark?: URI; light?: URI }): Promise<string | undefined> {
+		const uri = URI.isUri(icon) ? icon : (icon.dark ?? icon.light);
+		if (!uri) {
+			return Promise.resolve(undefined);
+		}
+		const key = uri.toString();
+		let cached = this.iconCache.get(key);
+		if (!cached) {
+			cached = new Promise<string | undefined>(resolve => {
+				const image = new Image();
+				image.onload = () => {
+					try {
+						const canvas = mainWindow.document.createElement('canvas');
+						canvas.width = canvas.height = 96;
+						canvas.getContext('2d')?.drawImage(image, 0, 0, 96, 96);
+						resolve(canvas.toDataURL('image/png'));
+					} catch {
+						resolve(undefined);
+					}
+				};
+				image.onerror = () => resolve(undefined);
+				image.src = FileAccess.uriToBrowserUri(uri).toString(true);
+			});
+			this.iconCache.set(key, cached);
+		}
+		return cached;
+	}
+}
